@charset "utf-8";

#experience { --stage-width: min(100vw, calc(100svh * 2143 / 734)); color-scheme: light; font-family: Georgia, "Times New Roman", serif; background: rgb(238, 191, 196); color: rgb(156, 76, 93); }

@font-face { font-family: "Loi Tri An"; src: url("../assets/fonts/GreatVibes-Regular.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: block; }

#experience[hidden], #experience [hidden] { display: none !important; }

#experience .color-definitions { position: absolute; width: 0px; height: 0px; overflow: hidden; pointer-events: none; }

#experience { position: fixed; inset: 0px; z-index: 90; width: 100%; height: 100svh; overflow: hidden; isolation: isolate; display: grid; place-items: center; }

#experience .surroundings { position: absolute; inset: 0px; z-index: -1; background: linear-gradient(rgba(233, 245, 255, 0.25) 0%, rgba(255, 248, 237, 0.19) 38%, rgba(255, 247, 223, 0.15) 70%, rgba(255, 241, 229, 0.1) 100%), url("../assets/images/nen-lien-mach.png") center center / cover no-repeat; filter: saturate(0.68) contrast(0.96) brightness(1.045); }

#experience .stage { position: relative; width: var(--stage-width); aspect-ratio: 2143 / 734; flex: 0 0 auto; overflow: visible; transform: translateY(var(--ground-offset, 0px)); }

#experience .stage:not(.is-ready) { visibility: hidden; }

#experience .film-scene { position: absolute; inset: 0px; }

#experience .film-scene img { display: block; width: 100%; height: 100%; user-select: none; pointer-events: none; }

#experience .collage, #experience .collage-cache, #experience .intro-complete, #experience .film-artwork, #experience .film-canvas { position: absolute; inset: 0px; width: 100%; height: 100%; }

#experience .collage { overflow: visible; }

#experience .collage, #experience .collage-cache, #experience .intro-complete { transform: translateX(var(--collage-shift, 0%)); }

#experience .is-preparing #collage-tiles { visibility: hidden; }

#experience .collage-cache { pointer-events: none; }

#experience .collage-cache__tile { position: absolute; opacity: 0; will-change: transform, opacity; }

#experience .collage-cache__tile.is-settled { will-change: auto; }

#experience .collage-cache__reflection { position: absolute; left: 0px; top: 82.425%; width: 100%; height: 17.575%; opacity: 0; }

#experience .film-intro.is-assembled .collage-cache__reflection { opacity: 1; }

#experience .photo-tile, #experience .collage-insert { transform-box: view-box; will-change: transform, opacity; }

#experience .photo-tile.is-settled, #experience .collage-insert.is-settled { will-change: auto; }

#experience .photo-surface { filter: url("#photo-warmth"); }

#experience .collage-inserts { pointer-events: none; }

#experience .collage-insert { opacity: 0; }

#experience .memory-doodles { fill: none; stroke: rgb(238, 143, 136); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(rgb(255, 245, 220) 0px 1px 1px); }

#experience .collage-ribbon { opacity: 0; stroke-width: 3.2px; pointer-events: none; }

#experience .film-intro.is-assembled .collage-ribbon { opacity: 1; transition: opacity 0.38s; }

#experience .intro-complete { opacity: 0; }

#experience .film-intro.is-assembled .intro-complete { opacity: 1; }

#experience .film-canvas { pointer-events: none; transform: translateZ(0px); }

#experience .film-strip { position: absolute; inset: 0px; transform: scaleX(var(--film-stretch, 1.18)); transform-origin: 50.4% 50%; }

#experience .film-artwork { pointer-events: none; clip-path: url("#film-frame-clip"); filter: url("#pastel-decoration"); }

#experience .intro-dedication, #experience .film-dedication { position: absolute; left: 50.4%; top: var(--film-title-top, -14%); width: var(--film-title-width, min(78%, 980px)); height: auto; overflow: visible; transform: translateX(-50%); pointer-events: none; }

#experience .intro-dedication { left: 50%; top: var(--intro-title-top, -14%); width: var(--intro-title-width, min(78%, 980px)); }

#experience .intro-dedication .tribute-text, #experience .film-dedication .tribute-text { word-spacing: 5px; }

#experience .film-dedication .dedication-date { word-spacing: normal; }

#experience .tribute-lines.dedication-flourish { stroke-width: 1.8px; }

#experience .tribute-text { font-family: "Loi Tri An", cursive; font-weight: 400; fill: rgb(239, 115, 111); stroke: rgb(239, 115, 111); stroke-width: 0.65px; stroke-linejoin: round; paint-order: stroke; filter: drop-shadow(rgb(255, 246, 229) 0px 1px 0.5px); }

#experience .tribute-lines { fill: none; stroke: rgb(239, 124, 116); stroke-width: 3.6px; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(rgb(255, 244, 219) 0px 1px 1px); }

#experience .tribute-fine { stroke-width: 2.5px; }

#experience .book-paper { fill: rgba(255, 248, 228, 0.24); }

#experience .film-viewport { position: absolute; left: 13.8%; top: 8.5%; width: 73.2%; height: 75%; cursor: grab; touch-action: none; overscroll-behavior: contain; user-select: none; -webkit-tap-highlight-color: transparent; border-radius: 7%; }

#experience .film-viewport.is-dragging { cursor: grabbing; }

#experience .film-viewport:focus-visible { outline: rgb(255, 243, 219) solid 2px; outline-offset: 5px; box-shadow: rgb(249, 158, 172) 0px 0px 24px; }

#experience .transition-glow { position: absolute; inset: 0px; background: radial-gradient(at 52% 55%, rgba(255, 247, 220, 0.9), rgba(255, 228, 207, 0.333) 50%, rgba(255, 228, 207, 0) 100%); pointer-events: none; opacity: 0; z-index: 3; }

#experience .load-error, #experience .noscript { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); width: max-content; max-width: 90vw; margin: 0px; padding: 12px 20px; border-radius: 12px; background: rgb(255, 246, 232); text-align: center; font: 14px / 1.5 Arial, sans-serif; z-index: 10; }

@media (prefers-reduced-motion: reduce) {
  #experience .film-intro.is-assembled .collage-ribbon { transition: none; }
}
