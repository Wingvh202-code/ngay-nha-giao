@charset "utf-8";

.is-gift-preview body::after, .is-gift-preview dialog::after { content: ""; position: fixed; inset: 0px; z-index: 119; background: url("../assets/images/preview-watermark.svg") center center / 320px 220px repeat; pointer-events: none; user-select: none; }

.gift-preview-error button { border: 1px solid rgb(229, 192, 207); border-radius: 30px; background: rgb(255, 255, 255); color: rgb(163, 71, 107); cursor: pointer; font: 12px "Segoe UI", Arial, sans-serif; padding: 8px 12px; }

.gift-preview-error button:focus-visible { outline: rgb(204, 115, 153) solid 3px; outline-offset: 3px; }

.gift-preview-error { position: fixed; z-index: 121; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(420px, 100% - 40px); padding: 28px; text-align: center; border-radius: 18px; background: rgb(255, 248, 251); box-shadow: rgba(87, 48, 71, 0.314) 0px 20px 100px; border: 1px solid rgb(234, 194, 213); color: rgb(146, 81, 106); font: 15px / 1.7 "Segoe UI", Arial, sans-serif; }

.gift-preview-error p { margin: 0px 0px 20px; }

.is-no-film #continueLetter { display: none !important; }

@media (max-width: 600px) {
  .is-gift-preview body::after, .is-gift-preview dialog::after { background-size: 240px 165px; }
}
